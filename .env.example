# Port aplikasi backend
PORT=8080

# Kunci rahasia JWT
JWT_SECRET=your_jwt_secret_key_example_change_me

# Kredensial Database PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=pojok_teduh_db
DB_PORT=5432

# URL Koneksi Database
# Gunakan 'db' sebagai host saat berjalan di dalam jaringan Docker Compose:
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/pojok_teduh_db?schema=public

# Gunakan 'localhost' jika mengakses database container dari host machine:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pojok_teduh_db?schema=public
